[Unit]
Description=Photo Frame
DefaultDependencies=no
After=multi-user.target

[Service]
Type=idle
RemainAfterExit=yes
User=pi
ExecStart=/bin/bash /home/pi/photo.sh
StandardInput=tty
TTYPath=/dev/tty1
StandardOutput=file:/home/pi/photos.log
StandardError=file:/home/pi/photos.log

[Install]
WantedBy=multi-user.target
